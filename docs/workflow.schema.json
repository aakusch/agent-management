{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/workflow.schema.json",
  "title": "Relay workflow",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "project", "nodes", "edges", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "template": {
      "type": "object",
      "required": ["id", "name", "requiredModuleIds", "adaptationRules"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "requiredModuleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "adaptationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["moduleId", "action", "reason"],
            "properties": {
              "capability": { "enum": ["web", "service", "database", "containers", "documentation", "benchmarks"] },
              "structure": { "enum": ["monorepo", "multi-repository"] },
              "moduleId": { "type": "string" },
              "action": { "enum": ["include", "optional"] },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["name", "root", "branch", "variables", "defaults", "permissions"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "branch": { "type": "string" },
        "variables": { "type": "object", "additionalProperties": { "type": "string" } },
        "defaults": {
          "type": "object",
          "required": ["model", "effort", "maxParallelAgents", "tools"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "effort": { "enum": ["low", "medium", "high", "xhigh"] },
            "maxParallelAgents": { "type": "integer", "minimum": 1, "maximum": 16 },
            "tools": { "type": "array", "items": { "enum": ["filesystem", "terminal", "git", "browser", "web"] }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "required": ["spawnAgents", "shell", "network", "publish"],
          "properties": {
            "spawnAgents": { "type": "boolean" },
            "shell": { "enum": ["project", "read-only", "none"] },
            "network": { "enum": ["ask", "allow", "deny"] },
            "publish": { "enum": ["ask", "allow", "deny"] }
          },
          "additionalProperties": false
        },
        "profile": {
          "type": "object",
          "required": ["status", "structure", "packageManager", "capabilities", "instructions", "commands"],
          "properties": {
            "status": { "enum": ["not-scanned", "configured", "scan-requested", "ready"] },
            "structure": { "enum": ["unknown", "single-package", "monorepo", "multi-repository"] },
            "packageManager": { "enum": ["auto", "npm", "pnpm", "yarn", "bun", "python", "mixed"] },
            "capabilities": { "type": "array", "items": { "enum": ["web", "service", "database", "containers", "documentation", "benchmarks"] }, "uniqueItems": true },
            "instructions": { "type": "array", "items": { "type": "string" } },
            "commands": { "type": "object", "additionalProperties": { "type": "string" } },
            "scannedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["manual", "catalyst"] },
        "nodeId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "required": ["enabled", "componentId", "mode", "artifact", "maySelectOptionalModules", "mayBindProjectCommands", "mayConfigureNodes", "mayRemoveRequiredModules", "mayWidenPermissions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "componentId": { "const": "workflow-specifier" },
        "mode": { "enum": ["guided", "exact"] },
        "artifact": { "const": "run-spec.json" },
        "maySelectOptionalModules": { "type": "boolean" },
        "mayBindProjectCommands": { "type": "boolean" },
        "mayConfigureNodes": { "type": "boolean" },
        "mayRemoveRequiredModules": { "const": false },
        "mayWidenPermissions": { "const": false }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "position", "data"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "workflow" },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "data": {
            "type": "object",
            "required": ["label", "templateId", "kind", "instruction", "overrides"],
            "properties": {
              "label": { "type": "string" },
              "description": { "type": "string" },
              "templateId": { "type": "string" },
              "kind": { "enum": ["agent", "judge", "router", "human", "tool", "module", "workflow", "catalyst"] },
              "instruction": { "type": "string" },
              "overrides": { "type": "object", "additionalProperties": { "type": "string" } },
              "execution": {
                "type": "object",
                "properties": {
                  "model": { "type": "string" },
                  "effort": { "enum": ["low", "medium", "high", "xhigh"] },
                  "tools": { "type": "array", "items": { "enum": ["filesystem", "terminal", "git", "browser", "web"] }, "uniqueItems": true }
                },
                "additionalProperties": false
              },
              "catalyst": {
                "type": "object",
                "properties": {
                  "definitionId": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "subworkflow": {
                "type": "object",
                "required": ["workflowId", "execution", "context", "onFailure"],
                "properties": {
                  "workflowId": { "type": "string", "minLength": 1 },
                  "execution": { "enum": ["inline", "isolated"] },
                  "context": { "enum": ["inherit", "mapped", "none"] },
                  "onFailure": { "enum": ["bubble", "pause", "continue"] }
                },
                "additionalProperties": false
              },
              "module": {
                "type": "object",
                "required": ["moduleId", "version", "mode"],
                "properties": {
                  "moduleId": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "mode": { "enum": ["linked", "detached"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "trigger": { "enum": ["always", "condition", "human"] },
              "condition": { "type": "string", "description": "Required in practice when trigger is \"condition\"." },
              "tone": { "enum": ["default", "success", "danger", "warning"] },
              "handoff": {
                "enum": ["signal", "summary", "full"],
                "description": "What the next step receives. One choice, not a field-by-field manifest. Documents saved before this simplification carried a payload object and a structured handoff object; both collapse into this on load."
              },
              "loop": {
                "type": "object",
                "required": ["mode", "onExhausted"],
                "properties": {
                  "mode": { "enum": ["bounded", "until-cancelled"] },
                  "maxIterations": { "type": "integer", "minimum": 1 },
                  "maxDurationMinutes": { "type": "integer", "minimum": 1 },
                  "stopOnNoProgress": { "type": "integer", "minimum": 1 },
                  "onExhausted": { "enum": ["fail", "pause", "human"] }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
