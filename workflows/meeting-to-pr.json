      "catchup.command": "./catch-up",
      "base.branch": "develop"
    },
    "defaults": {
      "model": "auto",
      "effort": "high",
      "maxParallelAgents": 3,
      "tools": [
        "filesystem",
        "terminal",
        "git"
      ]
    },
    "permissions": {
      "spawnAgents": true,
      "shell": "project",
      "network": "ask",
      "publish": "ask"
    },
