{
  "schemaVersion": "1.0",
  "id": "meeting-to-pr",
  "name": "Meeting to PR",
  "description": "Take a change someone asked for in a BHG meeting through to a PR against develop, asking rather than guessing and leaving the merge to Aaron.",
