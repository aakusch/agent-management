    { "id": "gate-loop", "source": "gate", "target": "implement", "sourceHandle": "source-bottom", "targetHandle": "target-bottom", "type": "workflow", "data": { "label": "revise", "condition": "route == revise", "tone": "danger", "loop": { "mode": "bounded", "maxIterations": 3, "maxDurationMinutes": 30, "stopOnNoProgress": 2, "onExhausted": "human" } } }
